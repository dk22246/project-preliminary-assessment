{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic policy-search coverage ledger",
  "type": "object",
  "required": ["version", "enterprise", "researched_at", "search_mode", "landing_business_hypotheses", "searches", "policy_candidates"],
  "properties": {
    "version": {"type": "string"},
    "enterprise": {"type": "string", "minLength": 1},
    "researched_at": {"type": "string", "format": "date-time"},
    "search_mode": {"const": "realtime"},
    "landing_business_hypotheses": {"type": "array", "minItems": 1},
    "searches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "department_searches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "runs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "query": {"type": "string"},
                      "checked_at": {"type": "string", "format": "date-time"},
                      "result_count": {"type": "integer", "minimum": 0},
                      "result_source_ids": {"type": "array"},
                      "evidence_record_ids": {"type": "array"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "policy_candidates": {"type": "array"}
  },
  "additionalProperties": true
}
