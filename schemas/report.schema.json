{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanya CBD Preliminary Assessment Report Data",
  "type": "object",
  "required": ["meta", "entity_resolution", "equity", "businesses", "encouraged_industry_assessment", "industry_position", "financials", "risks", "landing_businesses", "policy_research", "policy_opportunity_radar", "policies", "sources"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["report_title", "generated_at", "reporting_entity", "policy_researched_at", "policy_search_mode"],
      "properties": {
        "policy_researched_at": {"type": "string", "format": "date-time"},
        "policy_search_mode": {"const": "realtime"},
        "financial_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "financial_unit": {"type": "string", "minLength": 1, "maxLength": 20}
      }
    },
    "entity_resolution": {"type": "object", "required": ["user_input", "name_type", "legal_entity", "analysis_entity", "financial_scope", "risk_scope"]},
    "equity": {
      "type": "object",
      "required": ["nodes", "edges", "conflict_disclosures", "evidence_summary"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "entity_type", "role", "evidence_source_ids"],
            "properties": {
              "evidence_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E"}}
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from", "to", "relationship", "evidence_source_ids"],
            "properties": {
              "ownership_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
              "is_remainder": {"type": "boolean"},
              "evidence_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E"}}
            }
          }
        },
        "conflict_disclosures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "field", "severity", "status", "title", "difference", "reason", "adopted_basis", "impact", "next_action", "graph_action", "affected_node_ids", "affected_edges", "evidence_source_ids"],
            "properties": {
              "id": {"type": "string", "pattern": "^C[0-9]+$"},
              "severity": {"enum": ["general", "material_local", "subject_critical"]},
              "status": {"enum": ["resolved", "unresolved"]},
              "graph_action": {"enum": ["keep_confirmed_part", "omit_disputed_part"]},
              "evidence_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E"}}
            }
          }
        },
        "evidence_summary": {
          "type": "object",
          "required": ["display_source_id", "display_source_title", "as_of_date"],
          "properties": {
            "display_source_id": {"type": "string", "pattern": "^E"},
            "display_source_title": {"type": "string", "minLength": 1},
            "as_of_date": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "businesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "segment", "products", "entity", "revenue_model", "footprint", "sanya_fit"],
        "properties": {"id": {"type": "string", "pattern": "^B[0-9]+$"}}
      }
    },
    "encouraged_industry_assessment": {
      "type": "object",
      "required": ["catalog_version", "overall_judgment", "summary", "catalogs_checked", "business_assessments"],
      "properties": {
        "overall_judgment": {"enum": ["direct_match", "potential_match_only", "no_match", "research_incomplete"]},
        "catalogs_checked": {"type": "array", "minItems": 3, "maxItems": 3},
        "business_assessments": {"type": "array", "minItems": 1}
      }
    },
    "industry_position": {
      "type": "object",
      "required": ["statement", "category", "position", "period", "source_ids"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "position": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E"}}
      }
    },
    "financials": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["year", "revenue", "revenue_change", "profit", "profit_change", "tax_value", "tax_basis", "government_support", "source"],
        "properties": {
          "year": {"type": "string", "minLength": 1},
          "revenue": {"type": "string", "pattern": "^(?:\\d{1,3}(?:,\\d{3})*|\\d+)(?:\\.\\d+)?$"},
          "revenue_change": {"type": "string", "pattern": "^(?:[+-]?\\d+(?:\\.\\d+)?%|—|未计算|未公开披露)$"},
          "profit": {"type": "string", "pattern": "^(?:\\d{1,3}(?:,\\d{3})*|\\d+)(?:\\.\\d+)?$"},
          "profit_change": {"type": "string", "pattern": "^(?:[+-]?\\d+(?:\\.\\d+)?%|—|未计算|未公开披露)$"},
          "change_note": {"type": "string", "maxLength": 160}
        }
      }
    },
    "government_support": {"type": "array"},
    "risks": {"type": "object"},
    "landing_businesses": {"type": "array", "minItems": 1},
    "policy_research": {"type": "array", "minItems": 1},
    "policy_opportunity_radar": {
      "type": "object",
      "required": ["signals"],
      "properties": {
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "signal_type", "fact", "source_ids", "opportunities"],
            "properties": {
              "id": {"type": "string", "pattern": "^S[0-9]+$"},
              "signal_type": {"type": "string", "minLength": 1},
              "fact": {"type": "string", "minLength": 1},
              "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[EF]"}},
              "opportunities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["topic", "disposition", "reason"],
                  "properties": {
                    "topic": {"type": "string", "minLength": 1},
                    "disposition": {"enum": ["surfaced", "merged", "excluded", "expired", "not_current", "pending_evidence", "research_incomplete"]},
                    "reason": {"type": "string", "minLength": 1},
                    "policy_source_ids": {"type": "array", "items": {"type": "string", "pattern": "^P"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {"type": "object"}
    },
    "sources": {"type": "array", "minItems": 1}
  }
}
