{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Discovery and Policy Routing Research Ledger",
  "type": "object",
  "required": ["enterprise", "enterprise_profile", "research_stop_gate", "fact_ledger", "business_candidates", "department_routes", "policy_candidates"],
  "properties": {
    "enterprise": {"type": "string", "minLength": 1},
    "enterprise_profile": {
      "type": "object",
      "required": ["analysis_entity", "listing_status", "research_route", "basis_source_ids"],
      "properties": {
        "analysis_entity": {"type": "string", "minLength": 1},
        "listing_status": {"enum": ["listed", "nonlisted"]},
        "research_route": {"enum": ["listed_disclosure", "nonlisted_public_evidence"]},
        "basis_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E"}}
      }
    },
    "research_stop_gate": {
      "type": "object",
      "required": ["source_channels", "required_topics", "discovery_rounds"],
      "properties": {
        "source_channels": {"type": "object", "minProperties": 1},
        "required_topics": {"type": "object"},
        "discovery_rounds": {"type": "array", "minItems": 1}
      }
    },
    "fact_ledger": {"type": "array", "minItems": 1},
    "business_candidates": {"type": "array", "minItems": 1},
    "department_routes": {"type": "array", "minItems": 1},
    "policy_candidates": {"type": "array"}
  }
}
