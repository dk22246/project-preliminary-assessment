{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Discovery and Policy Routing Research Ledger",
  "type": "object",
  "required": ["enterprise", "enterprise_profile", "research_stop_gate", "fact_ledger", "business_candidates", "department_routes", "policy_candidates"],
  "properties": {
    "enterprise": {"type": "string", "minLength": 1},
    "enterprise_profile": {
      "type": "object",
      "required": ["analysis_entity", "listing_status", "research_route", "basis_source_ids"],
      "properties": {
        "analysis_entity": {"type": "string", "minLength": 1},
        "listing_status": {"enum": ["listed", "nonlisted"]},
        "research_route": {"enum": ["listed_disclosure", "nonlisted_public_evidence"]},
        "basis_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E"}}
      }
    },
    "research_stop_gate": {
      "type": "object",
      "required": ["source_channels", "required_topics", "discovery_rounds"],
      "properties": {
        "source_channels": {"type": "object", "minProperties": 1},
        "required_topics": {"type": "object"},
        "discovery_rounds": {"type": "array", "minItems": 1},
        "nonlisted_evidence_checks": {
          "type": ["object", "null"],
          "required": ["business_evidence", "financial_boundary", "industry_500", "government_support", "risk_checks"],
          "properties": {
            "business_evidence": {
              "type": "object",
              "required": ["company_self_statement", "government_operating_records", "counterparty_disclosure"]
            },
            "financial_boundary": {
              "type": "object",
              "required": ["status", "proxy_inference_used"],
              "properties": {
                "status": {"enum": ["available", "partial", "not_public", "inaccessible"]},
                "proxy_inference_used": {"const": false},
                "operating_evidence_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[EF]"}},
                "reason": {"type": "string", "minLength": 1}
              }
            },
            "industry_500": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": {"enum": ["listed", "group_listed", "not_listed"]},
                "ranking_name": {"type": "string", "minLength": 1},
                "year": {"type": "string", "minLength": 1},
                "rank": {"type": "string", "minLength": 1},
                "listed_entity": {"type": "string", "minLength": 1},
                "issuer": {"type": "string", "minLength": 1},
                "relationship_note": {"type": "string", "minLength": 1},
                "report_statement": {"type": "string", "minLength": 1},
                "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E"}},
                "reason": {"type": "string", "minLength": 1}
              }
            },
            "government_support": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": {"enum": ["confirmed", "not_found", "inaccessible"]},
                "reason": {"type": "string", "minLength": 1},
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "evidence_type", "source_ids"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "evidence_type": {"enum": ["government_award_notice", "government_project_document", "company_formal_disclosure"]},
                      "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[EF]"}}
                    }
                  }
                }
              }
            },
            "risk_checks": {
              "type": "object",
              "required": ["administrative_and_abnormal", "tax_violations", "litigation_and_enforcement", "dishonesty_and_credit"]
            }
          }
        }
      }
    },
    "fact_ledger": {"type": "array", "minItems": 1},
    "business_candidates": {"type": "array", "minItems": 1},
    "department_routes": {"type": "array", "minItems": 1},
    "policy_candidates": {"type": "array"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enterprise_profile": {
            "properties": {"research_route": {"const": "nonlisted_public_evidence"}},
            "required": ["research_route"]
          }
        }
      },
      "then": {
        "properties": {
          "research_stop_gate": {"required": ["nonlisted_evidence_checks"]}
        }
      }
    }
  ]
}
