{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authenticated commercial-platform web equity capture",
  "type": "object",
  "required": ["legal_entity", "unified_social_credit_code", "registration_status", "page_url", "page_locator", "captured_at", "records", "coverage_dispositions"],
  "properties": {
    "legal_entity": {"type": "string", "minLength": 1},
    "unified_social_credit_code": {"type": "string", "minLength": 1},
    "registration_status": {"type": "string", "minLength": 1},
    "page_url": {"type": "string", "format": "uri"},
    "page_locator": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "data_as_of": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record_type", "entity_name", "entity_type", "page_locator", "assertion_type"],
        "properties": {
          "record_type": {"enum": ["current_shareholder", "actual_controller", "beneficial_owner", "historical_shareholder", "historical_change", "subsidiary"]},
          "entity_name": {"type": "string", "minLength": 1},
          "entity_type": {"type": "string", "minLength": 1},
          "relationship": {"type": "string"},
          "shareholding_ratio": {"type": "string", "minLength": 1},
          "data_as_of": {"type": "string", "minLength": 1},
          "page_locator": {"type": "string", "minLength": 1},
          "assertion_type": {"enum": ["registry_fact", "provider_calculation"]}
        },
        "allOf": [{
          "if": {"properties": {"assertion_type": {"const": "provider_calculation"}}},
          "then": {"required": ["relationship"], "properties": {"relationship": {"pattern": "推定|疑似|平台穿透"}}}
        }, {
          "if": {"properties": {"record_type": {"const": "current_shareholder"}}},
          "then": {"required": ["shareholding_ratio"]}
        }]
      }
    },
    "coverage_dispositions": {
      "type": "object",
      "required": ["company_identity", "current_shareholder", "controller_or_beneficial_owner", "historical_change", "major_subsidiary"],
      "additionalProperties": false,
      "properties": {
        "company_identity": {"$ref": "#/$defs/coverage_disposition"},
        "current_shareholder": {"$ref": "#/$defs/coverage_disposition"},
        "controller_or_beneficial_owner": {"$ref": "#/$defs/coverage_disposition"},
        "historical_change": {"$ref": "#/$defs/coverage_disposition"},
        "major_subsidiary": {"$ref": "#/$defs/coverage_disposition"}
      }
    }
  },
  "$defs": {
    "coverage_disposition": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["captured", "not_disclosed", "inaccessible"]}, "reason": {"type": "string", "minLength": 1}},
      "allOf": [{"if": {"properties": {"status": {"enum": ["not_disclosed", "inaccessible"]}}}, "then": {"required": ["reason"]}}]
    }
  }
}
