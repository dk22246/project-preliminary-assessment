{
  "schema_version": "1.0",
  "python": ">=3.10",
  "node": ">=18",
  "default_output": [
    "python",
    "node",
    "playwright",
    "playwright-chromium",
    "chrome"
  ],
  "document_extraction": [
    "pypdf"
  ],
  "network": {
    "connect_timeout_seconds": 10,
    "read_timeout_seconds": 30,
    "max_retries": 2,
    "max_concurrency": 4,
    "per_host_concurrency": 2
  },
  "fingerprint_roots": [
    "agents",
    "references",
    "schemas",
    "scripts",
    "tests"
  ],
  "fingerprint_files": [
    "SKILL.md",
    "AGENTS.md",
    "runtime-requirements.json",
    "requirements-runtime.txt",
    "package.json",
    "package-lock.json"
  ]
}
