    "SKILL.md",
    "AGENTS.md",
    "runtime-requirements.json",
    "package.json",
    "package-lock.json",
    "schemas/report.schema.json",
    "schemas/policy-search-ledger.schema.json",
    "references/module-contract.json",
    "references/policy-opportunity-radar.md",
    "references/policy-search-coverage.md",
    "references/report-template.md",
    "scripts/report_core.py",
    "scripts/run_report_pipeline.py",
    "scripts/ppa.py",
    "scripts/workflow_state.py",
    "scripts/render_report_html.py",
    "scripts/render_report_word.py",
    "scripts/validate_policy_search_coverage.py",
    "scripts/validate_policy_scope.py",
    "scripts/verify_html_layout.mjs",
    "scripts/bootstrap.py",
    "scripts/doctor.py",
    "scripts/runtime_state.py",
    "scripts/discover_current_policies.py",
    "scripts/policy_cache.py",
    "scripts/validate_policy_evidence.py",
    "scripts/validate_research_stop_gate.py",
    "references/ranking-registry.json"
  ]
}
